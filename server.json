{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.conorbronsdon/transistor-mcp",
  "title": "Transistor MCP Server",
  "description": "Manage Transistor.fm podcasts: episodes, analytics, transcripts, and webhooks.",
  "repository": {
    "url": "https://github.com/conorbronsdon/Transistor-MCP",
    "source": "github"
  },
  "version": "0.2.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "transistor-mcp",
      "version": "0.2.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "TRANSISTOR_API_KEY",
          "description": "Transistor.fm API key from https://dashboard.transistor.fm/account",
          "isRequired": true
        }
      ]
    }
  ]
}
